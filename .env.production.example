# Production environment for docker-compose. On the server, copy this to `.env`
# in the same folder as docker-compose.yml and fill every value. NEVER commit
# the real .env.
#
# Moving to a new domain or server later = edit this file and run
# `docker compose up -d` again. The only external thing to update is the
# Google OAuth redirect URI (see below).

# The image built by GitHub Actions. Lower-case owner/repo.
IMAGE=ghcr.io/thefakealexx/cas_website:latest

# The public domain. Caddy issues the HTTPS certificate for exactly this, and
# the app builds its full public URL (APP_URL=https://APP_DOMAIN) from it — used
# for the OAuth redirect, sign-up links, and the post-login redirect. This is
# the single thing to change when the domain changes.
APP_DOMAIN=texnnet.com

# --- Database (runs in the mongo container) ---
# Any username; a long random password. Only these two containers ever see it.
MONGO_USER=cas
MONGO_PASSWORD=change-me-to-a-long-random-password

# --- Sessions ---
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Google sign-in (the only way in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In the Google Cloud console, the Authorised redirect URI must be:
#   https://texnnet.com/api/auth/google/callback
# (update it to match APP_DOMAIN whenever the domain changes)

# --- Bootstrap + maintainer ---
BOOTSTRAP_ADMIN_EMAIL=
# Keyed hash(es) — never the email. Generate with:
#   node scripts/maintainer-hash.mjs you@example.com
MAINTAINER_KEYS=
