# ---- Database -------------------------------------------------------------
# MongoDB Atlas connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cas?retryWrites=true&w=majority
MONGODB_URI=

# ---- Sessions -------------------------------------------------------------
# Any random 32+ character string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- Google sign-in (required — it is the only way to sign in) ------------
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if your deployed redirect URI differs from <origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Bootstrap ------------------------------------------------------------
# The only Google address that may sign in without an invitation link, so you
# have somebody who can create the first links.
BOOTSTRAP_ADMIN_EMAIL=

# ---- Maintainer (optional) ------------------------------------------------
# Comma-separated Google addresses granted owner/maintainer access — a tier
# above admin, used for support and break-glass. It is intentionally NOT stored
# in the database and NOT shown anywhere in the UI: the capability exists only
# for whoever is on this list, and the list lives only here (and in the hosting
# dashboard on production). Leave blank if you do not want it.
MAINTAINER_EMAILS=
