# ---- Database -------------------------------------------------------------
# MongoDB Atlas connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cas?retryWrites=true&w=majority
MONGODB_URI=

# ---- Sessions -------------------------------------------------------------
# Any random 32+ character string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- Google sign-in (required — it is the only way to sign in) ------------
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if your deployed redirect URI differs from <origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Bootstrap ------------------------------------------------------------
# The only Google address that may sign in without an invitation link, so you
# have somebody who can create the first links.
BOOTSTRAP_ADMIN_EMAIL=

# ---- Maintainer (optional) ------------------------------------------------
# Owner/maintainer access — a tier above admin, for support and break-glass.
# Stored as keyed HASHES of the Google address, never the address itself, so
# this value reveals nothing about whose account it is. Comma-separated hex
# digests. Generate one for an address with (using your real AUTH_SECRET):
#   node -e "console.log(require('crypto').createHmac('sha256','YOUR_AUTH_SECRET').update('you@example.com').digest('hex'))"
# Leave blank to disable. Regenerate the digests if you rotate AUTH_SECRET.
MAINTAINER_KEYS=